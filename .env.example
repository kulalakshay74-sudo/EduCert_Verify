FLASK_SECRET_KEY=change-this-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
# Local durable database. For production/cloud, replace with a managed PostgreSQL DATABASE_URL.
DATABASE_URL=sqlite:///C:/path/to/EduCert_Verify/data/educert.db
# Optional: persistent mounted volume / object-storage-backed directory in production.
UPLOAD_DIR=C:/path/to/EduCert_Verify/data/uploads
MAX_UPLOAD_MB=50
MAX_BULK_FILES=100
